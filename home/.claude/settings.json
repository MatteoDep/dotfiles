{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash"
    ],
    "ask": [
      "mcp__atlassian-mcp-v2__executeWrite",
      "mcp__atlassian-mcp-v2__executeDestructive",
      "mcp__atlassian-mcp-v2__createJiraIssue",
      "mcp__atlassian-mcp-v2__editJiraIssue",
      "mcp__atlassian-mcp-v2__transitionJiraIssue",
      "mcp__atlassian-mcp-v2__addOrEditJiraIssueComment",
      "mcp__atlassian-mcp-v2__createConfluenceContent",
      "mcp__atlassian-mcp-v2__updateConfluenceContent",
      "mcp__atlassian-mcp-v2__addGraphContext",
      "Bash(atlassian api * -X*)",
      "Bash(atlassian api * --request*)",
      "Bash(atlassian api * -d*)",
      "Bash(atlassian api * --data *)",
      "Bash(atlassian api * --data-raw*)",
      "Bash(atlassian api * --data-binary*)",
      "Bash(atlassian api * --json*)",
      "Bash(atlassian api * -F*)",
      "Bash(atlassian api * --form*)"
    ],
    "deny": [
      "Read(~/.pgpass)",
      "Read(~/.config/dadbod/**)",
      "Read(~/.local/state/nvim/undo/**)",
      "Read(~/.local/state/nvim/swap/**)",
      "Read(~/.local/state/nvim/shada/**)",
      "Edit(~/.pg_service.conf)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "cleanupPeriodDays": 365,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/matteo/.claude/hooks/check-earlyoom.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "nvim --clean -l /home/matteo/.config/nvim/scripts/dadbod_sync.lua >/dev/null 2>&1 || echo 'dadbod connection sync reported problems: tell the user to run :DBSyncPgpass in nvim'; exit 0",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/matteo/.claude/hooks/db-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/matteo/.claude/hooks/loop-no-cloud.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/matteo/.claude/telegram/ping.py notification",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/matteo/.claude/telegram/ping.py stop",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/matteo/.claude/telegram/ping.py publish",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"/home/matteo/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "telegram@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "humanizer@humanizer": true,
    "leftovers@local-mods": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "blader/humanizer"
      }
    },
    "local-mods": {
      "source": {
        "source": "directory",
        "path": "/home/matteo/.claude/mods"
      }
    }
  },
  "sandbox": {
    "enabled": false,
    "network": {
      "allowAllUnixSockets": true
    },
    "filesystem": {
      "allowWrite": [
        "/home/matteo/repos/db-schema",
        "/home/matteo/.cache/uv"
      ]
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "voiceEnabled": true
}
