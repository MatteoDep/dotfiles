[pull]
	rebase = false
[user]
	name = Matteo De Pellegrin
[core]
	pager = diff-so-fancy | less --tabs=4 -RFX
[interactive]
	diffFilter = diff-so-fancy --patch
[color]
	ui = true
[color "diff-highlight"]
	oldNormal = red
	oldHighlight = red 52
	newNormal = green
	newHighlight = green 22
[color "diff"]
	meta = 11
	frag = magenta
	func = 146
	commit = yellow
	old = red
	new = green
	whitespace = red reverse
# work identity and settings, kept out of this repo (personal overrides it below)
# register maintenance there too: git maintenance register --config-file ~/.gitconfig-work
[include]
	path = .gitconfig-work
[includeIf "gitdir:~/projects/"]
	path = .gitconfig-personal
[includeIf "gitdir:~/.config/nvim/"]
	path = .gitconfig-personal
[diff]
	colormoved = default
    tool = nvimdiff
[difftool]
    prompt = true
[difftool "nvimdiff"]
    cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""tool = nvimdiff
